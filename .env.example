# LLM Provider: gemini | openai | claude | offline
DOCQA_LLM_PROVIDER=offline

# Gemini API (used when DOCQA_LLM_PROVIDER=gemini or DOCQA_USE_EMBEDDINGS=true)
GEMINI_API_KEY=
DOCQA_GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (used when DOCQA_LLM_PROVIDER=openai)
OPENAI_API_KEY=
DOCQA_OPENAI_MODEL=gpt-4o-mini

# Claude (Anthropic) API (used when DOCQA_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
DOCQA_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional dense embeddings for hybrid retrieval (true | false)
DOCQA_USE_EMBEDDINGS=false

# Storage & Chunking
DOCQA_DOCS_DIR=./sample_docs
DOCQA_INDEX_PATH=./.docqa_index.json
DOCQA_CHUNK_SIZE=700
DOCQA_CHUNK_OVERLAP=120
DOCQA_TOP_K=4
